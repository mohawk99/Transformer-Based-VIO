{
	"n_freq_print": 20,
	"n_freq_checkpoint": 25,
	"n_workers": 4,
	"device_id": "cuda:0",
	
	"input_dim": 6,
	"window_size":200,
    "window_shift": 10,
	
	"hidden_dim": 128,
	"nhead": 8,
	"num_encoder_layers": 4, 
	"num_decoder_layers": 4, 
	"dim_feedforward": 1024, 
    "dropout": 0.1,
	
	"batch_size": 64, 
	"lr": 5e-4,
	"weight_decay":5e-04,
	"eps": 1e-6,
	"grad_clip": 1.0,


	"n_epochs": 50,

	"scheduler": {
        "type": "plateau",
        "factor": 0.5,
        "patience": 3,
        "cooldown": 2,
        "min_lr": 1e-6,
        "threshold": 1e-4,
        "verbose": true
    }

}
